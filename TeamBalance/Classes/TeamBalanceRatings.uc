//=============================================================================
// TeamBalanceRatings
// Holds the per-GUID ratings. Read from System\TeamBalanceRatings.ini, which
// is generated by Tools\GetPlayerRankings.ps1 from the FlawsFightNight bot's
// player profiles (never edited by hand, never written by the game).
//
//   [TeamBalance.TeamBalanceRatings]
//   FormatVersion=1                      (optional, written by the script)
//   GeneratedAt=2026-10-21 10:49 UTC     (optional)
//   ExpectedCount=321                    (optional; lets the mutator spot partly-read files)
//   PlayerRatings=(Guid="007d...",Elo=7.96,Mu=25.0,Sigma=8.333,Rating=0.0)
//=============================================================================
class TeamBalanceRatings extends Object
    config(TeamBalanceRatings);

struct RatingEntry
{
    var string Guid;
    var float  Elo;
    var float  Mu;
    var float  Sigma;
    var float  Rating;
};

var config int    FormatVersion;
var config string GeneratedAt;
var config int    ExpectedCount;

var config array<RatingEntry> PlayerRatings;

defaultproperties
{
}
